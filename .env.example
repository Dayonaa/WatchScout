# ==============================================================================
# Watch Dealer RAG & NER Engine - Environment Configuration
# ==============================================================================

# [Wajib untuk Ekspansi LLM] Google Gemini API Key
# Dapatkan key dari: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# Parameter Pelatihan, Retraining & Ekspansi LLM
# ==============================================================================
WATCH_TRAIN_ITER=20              # Jumlah iterasi pelatihan spaCy NER (default: 20)
WATCH_AUTO_TRAIN_EVERY=25        # Ambang batas item stream untuk auto-retraining (default: 25)
WATCH_AUTO_EXPAND_EVERY=10       # Ambang batas unparsed queue untuk otomatis panggil Gemini & retrain (default: 10)
WATCH_EXPAND_RETRAIN=true        # Otomatis retrain spaCy setelah Gemini menemukan pola baru
WATCH_EXPAND_MAX=0               # Jumlah baris unparsed yang dianalisis (0 = seluruh antrean)
WATCH_STREAM_SPEED=0.2           # Delay simulasi pesan masuk stream (detik per chat)
WATCH_DEVICE=auto                # Mode hardware: auto (CUDA jika ada, fallback CPU), cuda, atau cpu

# ==============================================================================
# [Opsional] Override Path Standalone Deployment (Default mengarah ke folder lokal)
# ==============================================================================
# WATCH_DB_PATH=/path/to/data/watches.duckdb
# WATCH_MODEL_DIR=/path/to/models/watch_ner
# WATCH_RULES_PATH=/path/to/models/dynamic_rules.json
# WATCH_DATASETS_DIR=/path/to/datasets

# ==============================================================================
# --- REMOTE POSTGRESQL (PRODUCTION/STAGING) ---
# ==============================================================================
# DB_CONNECTION=pgsql
# DB_HOST=your_postgres_host
# DB_PORT=5432
# DB_DATABASE=scraper
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_TABLE=watch_broadcasts
